{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a registered Telegram user",
      "type": "object",
      "properties": {
        "telegramId": { "type": "string" },
        "username": { "type": "string" },
        "firstName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "holdBalance": { "type": "number", "default": 0 },
        "activeBalance": { "type": "number", "default": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["telegramId", "username"]
    },
    "Submission": {
      "title": "Submission",
      "description": "An account or detail submission by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "qrCodeUrl": { "type": "string", "description": "Base64 encoded string of the uploaded QR code image" },
        "earnings": { "type": "number", "default": 1.12 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "password"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Collection of user profiles and wallet balances"
    },
    "/submissions/{submissionId}": {
      "schema": "#/entities/Submission",
      "description": "Collection of account submissions for admin verification"
    }
  }
}
