
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a user including their active and hold balances",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "holdBalance": { "type": "number", "default": 0 },
        "activeBalance": { "type": "number", "default": 0 },
        "telegramChatId": { "type": "string", "description": "The user's Telegram Chat ID for notifications" },
        "isAdmin": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Submission": {
      "title": "Submission",
      "description": "An account or detail submission by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "accountEmail": { "type": "string" },
        "password": { "type": "string" },
        "qrCodeUrl": { "type": "string", "description": "Base64 encoded string of the uploaded QR code image" },
        "earnings": { "type": "number", "default": 1.12 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "accountEmail", "password"]
    },
    "PayoutRequest": {
      "title": "Payout Request",
      "description": "A request by a user to withdraw funds",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "usdtAddress": { "type": "string", "description": "USDT BEP20 wallet address" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "usdtAddress"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Collection of user profiles and wallet balances."
    },
    "/submissions/{submissionId}": {
      "schema": "#/entities/Submission",
      "description": "Collection of account submissions."
    },
    "/payouts/{payoutId}": {
      "schema": "#/entities/PayoutRequest",
      "description": "Collection of withdrawal requests."
    }
  }
}
